# ---- Vector DB (pgvector) ----
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ---- Business DB (MySQL / Sakila) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=sakila
MYSQL_PASSWORD=p_ssW0rd
MYSQL_DATABASE=sakila

# ---- Embeddings (local CPU, free) ----
# English, small/fast:       BAAI/bge-small-en-v1.5  (dim 384)
# Multilingual (Thai etc.):  BAAI/bge-m3             (dim 1024, ~2GB download)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---- Vision model: reads the schema diagram image -> text. Any OpenAI-compatible endpoint. ----
# Option A (default): Ollama, free & local.   ollama pull qwen2.5vl:7b   (lighter: qwen2.5vl:3b)
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen2.5vl:7b
# Option B: Hugging Face Inference Providers (free monthly credits; check current limits/models)
#   Model must be a Hub id (Org/Name) that at least one ENABLED provider serves. ':provider' or ':fastest' may be appended.
#   Ollama tags such as qwen2.5vl:7b are NOT valid here. Token needs the 'Make calls to Inference Providers' permission.
#   Browse: https://huggingface.co/models?inference_provider=all&pipeline_tag=image-text-to-text
# VLM_BASE_URL=https://router.huggingface.co/v1
# VLM_API_KEY=hf_xxx
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Option C: Google AI Studio free tier (OpenAI-compatible endpoint)
# VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VLM_API_KEY=your_ai_studio_key
# VLM_MODEL=gemini-2.5-flash
VLM_DELAY_SEC=1.0

# ---- Answer / text-to-SQL LLM (text only). Same provider options as above. ----
# Hugging Face example:  LLM_BASE_URL=https://router.huggingface.co/v1  LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct:fastest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# ---- Parsing / retrieval ----
# vector paths needed before a page region counts as a diagram
DIAGRAM_MIN_DRAWINGS=40
RETRIEVE_K=8
MAX_ROWS=100

# ---- Decision trail: every question is saved to the query_log table (view: History page / `python -m kb trace`) ----
TRACE_ENABLED=1
TRACE_MAX_CHARS=30000
