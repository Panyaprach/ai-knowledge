# Embeddings run locally unless EMBED_BASE_URL is set. EMBED_DIM must match the model's vector size.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_SEND_DIMENSIONS=0
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=
# Ollama:  EMBED_BASE_URL=http://localhost:11434/v1  EMBED_API_KEY=ollama  EMBED_MODEL=nomic-embed-text  EMBED_DIM=768
# OpenAI:  EMBED_BASE_URL=https://api.openai.com/v1  EMBED_MODEL=text-embedding-3-small  EMBED_DIM=1536

# Vision model (reads the schema diagram). Any OpenAI-compatible endpoint that accepts images.
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen2.5vl:7b
VLM_DELAY_SEC=1.0
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=1500
VLM_FREQUENCY_PENALTY=0
# Hugging Face:  https://router.huggingface.co/v1   Org/Model-Name
# Google AI Studio:  https://generativelanguage.googleapis.com/v1beta/openai/   a Gemini flash model id

# Answer / text-to-SQL model (text only).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

DIAGRAM_MIN_DRAWINGS=40
RETRIEVE_K=8
MAX_ROWS=100

TRACE_ENABLED=1
TRACE_MAX_CHARS=30000
USAGE_ENABLED=1
KB_LOG_LEVEL=info
